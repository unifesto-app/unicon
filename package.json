{
  "name": "@unifesto/unicon",
  "version": "2.0.0",
  "description": "Unifesto glyph icons (tintable SVG) for React, Next.js, Expo and React Native",
  "author": "Unifesto Private Limited",
  "license": "UNLICENSED",
  "private": false,
  "type": "module",
  "main": "./dist/glyphs/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/glyphs/index.js"
    },
    "./react": {
      "types": "./dist/index.d.ts",
      "import": "./dist/react/index.js",
      "default": "./dist/react/index.js"
    },
    "./react-native": {
      "types": "./dist/index.d.ts",
      "import": "./dist/react-native/index.js",
      "default": "./dist/react-native/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.js",
    "clean": "rm -rf dist",
    "rebuild": "npm run clean && npm run build",
    "prepublishOnly": "npm run build",
    "pack:test": "npm pack --dry-run",
    "version": "npm run build && git add -f -A dist",
    "postversion": "git push && git push --tags",
    "patch": "git add . && git commit -m 'update' && git push origin main && git version patch",
    "import:phosphor": "node scripts/import-phosphor.js"
  },
  "keywords": [
    "icons",
    "icon-library",
    "react",
    "react-icons",
    "nextjs",
    "expo",
    "react-native",
    "react-native-icons",
    "unifesto",
    "cross-platform",
    "typescript",
    "ui",
    "components",
    "ui-components",
    "icon-pack",
    "design-system",
    "svg"
  ],
  "peerDependencies": {
    "react": ">=16.8.0",
    "react-native-svg": ">=13.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-native-svg": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unifesto-app/unicon.git"
  },
  "bugs": {
    "url": "https://github.com/unifesto-app/unicon/issues"
  },
  "homepage": "https://github.com/unifesto-app/unicon#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "security": {
    "hasInstallScript": false,
    "hasBuildScript": false,
    "hasPrePublishScript": true,
    "networkAccess": false,
    "shellAccess": false,
    "evalUsage": false,
    "environmentVariables": false
  },
  "devDependencies": {
    "@phosphor-icons/core": "2.1.1"
  }
}
